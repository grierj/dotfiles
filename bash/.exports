# Environment variables and PATH. Sourced by both ~/.bash_profile (login
# shells) and ~/.bashrc (interactive non-login shells), so everything here
# must be safe to run twice and in non-interactive shells.

# PATH helpers: add a directory once, only if it exists. This is what makes
# re-sourcing this file harmless instead of growing PATH duplicates.
path_prepend() {
  case ":${PATH}:" in
    *":$1:"*) ;;
    *) [ -d "$1" ] && PATH="$1:$PATH" ;;
  esac
}
path_append() {
  case ":${PATH}:" in
    *":$1:"*) ;;
    *) [ -d "$1" ] && PATH="$PATH:$1" ;;
  esac
}

# Prefer US English with UTF-8, but only if that locale actually exists on
# this machine. Naming an uninstalled locale (e.g. LANG="en_US" where only
# en_US.UTF-8 was generated) makes every nested bash print "warning:
# setlocale: LC_CTYPE: cannot change locale" via bash-completion.
# Deliberately do not set LC_ALL: it overrides every category and masks
# exactly this kind of problem.
if locale -a 2>/dev/null | grep -qix 'en_US\.utf-\?8'; then
  export LANG="en_US.UTF-8"
fi

# Make vim the default editor
export EDITOR="vim"
# Don't clear the screen after quitting a manual page
export MANPAGER="less -X"

# Larger bash history (allow 32^3 entries; default is 500)
export HISTSIZE=32768
export HISTFILESIZE=$HISTSIZE
# Ignore duplicates and commands starting with a space, erase older dups
export HISTCONTROL=ignoreboth:erasedups
export HISTTIMEFORMAT='%F %T '

# GPG terminal (only when we actually have one; `tty` prints junk otherwise)
if [ -t 1 ]; then
  GPG_TTY=$(tty 2>/dev/null)
  [ -n "$GPG_TTY" ] && export GPG_TTY
fi

# Add macports on macOS if homebrew isn't installed
if [[ "$OSTYPE" =~ ^darwin ]] && [ ! -f /usr/local/bin/brew ] && [ ! -f /opt/homebrew/bin/brew ]; then
  path_prepend /opt/local/sbin
  path_prepend /opt/local/bin
fi

# Homebrew (either prefix), needed by later path entries on macOS
if [[ "$OSTYPE" =~ ^darwin ]]; then
  path_prepend /opt/homebrew/bin
  path_prepend /opt/homebrew/sbin
fi

# /usr/local/sbin (homebrew on Intel macs, misc on Linux)
path_prepend /usr/local/sbin

# Go, if installed from the upstream tarball
path_prepend /usr/local/go/bin

# Default GOPATH and its bin directory
export GOPATH=$HOME/godev
path_prepend "$GOPATH/bin"

# mise shims, so non-interactive shells (scripts, `bash -lc`) find
# mise-managed tools even without `mise activate`
path_prepend "$HOME/.local/share/mise/shims"

# Pyenv shims, if pyenv is still around on this machine
path_prepend "$HOME/.pyenv/shims"

# Local bin directories
path_prepend "$HOME/.local/bin"
path_prepend "$HOME/bin"

# Startup script for the python REPL
export PYTHONSTARTUP=$HOME/.pythonrc

export PATH
